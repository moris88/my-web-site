{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./.npmrc)",
      "Read(./**/.npmrc)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/secrets/**)",
      "Read(./secrets.*)",
      "Read(./**/secrets.*)",
      "Read(./**/credentials/**)",
      "Read(./credentials.*)",
      "Read(./**/credentials.*)",
      "Read(./**/private/**)",
      "Edit(./.git/**)",
      "Edit(./node_modules/**)",
      "Edit(./app/**)",
      "Edit(./dist/**)",
      "Edit(./coverage/**)"
    ]
  }
}
